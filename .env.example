# Browser requests use the same origin by default. Set this only when the deployed
# frontend and backend cannot share an origin. Never place secrets in VITE_* values.
VITE_API_BASE_URL=

# Local Vite proxy target used by `pnpm dev`.
VITE_DEV_API_TARGET=http://localhost:8080

# Server-side Vercel rewrite target. Configure this in Vercel for Preview and
# Production; it is not exposed to browser code.
BACKEND_ORIGIN=https://your-backend.example.edu
